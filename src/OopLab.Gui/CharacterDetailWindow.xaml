<Window x:Class="OopLab.Gui.CharacterDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:OopLab.Gui.Converters"
        Title="Детальна картка персонажа"
        Height="520" Width="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#14181E" Foreground="#F3F4F6">
    <Window.Resources>
        <conv:HexColorToBrushConverter x:Key="HexBrush"/>
        <conv:LocalImageSourceConverter x:Key="ImgConverter"/>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#222933" BorderBrush="#343F4E" BorderThickness="1"
                CornerRadius="12" Padding="12" VerticalAlignment="Top">
            <StackPanel>
                <Border CornerRadius="8" ClipToBounds="True" Background="#14181E" Height="244">
                    <Image Source="{Binding EffectiveImageSource, Converter={StaticResource ImgConverter}}"
                           Stretch="UniformToFill"/>
                </Border>
                <Border Margin="0,12,0,0" Padding="8,5" CornerRadius="6"
                        Background="{Binding StatusColorHex, Converter={StaticResource HexBrush}}">
                    <TextBlock Text="{Binding StatusBadge}" FontWeight="Bold" FontSize="13"
                               Foreground="#111827" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding CacheStatusLabel}" Margin="0,8,0,0"
                           Foreground="#9CA3AF" FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="#222933" BorderBrush="#343F4E" BorderThickness="1"
                CornerRadius="12" Padding="20">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Bottom" Content="Закрити картку" Height="36" Margin="0,16,0,0"
                        Background="#38BDF8" Foreground="#0F172A" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Click="CloseButton_Click"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="24" FontWeight="Bold" Foreground="#F3F4F6"/>
                            <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="6" Background="#F59E0B">
                                <TextBlock Text="{Binding TierRank}" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="#9CA3AF" Margin="0,4,0,14"/>

                        <Border Background="#181E26" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="ХАРАКТЕРИСТИКИ ТА РЕЙТИНГ" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                <TextBlock Text="{Binding StatsSummary}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Світ походження:" FontSize="12" Foreground="#9CA3AF"/>
                        <TextBlock Text="{Binding OriginWorldLabel}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,10"/>

                        <TextBlock Text="Остання відома локація:" FontSize="12" Foreground="#9CA3AF"/>
                        <TextBlock Text="{Binding LocationLabel}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,10"/>

                        <TextBlock Text="Локальний шлях у буфері:" FontSize="12" Foreground="#9CA3AF"/>
                        <TextBlock Text="{Binding EffectiveImageSource}" FontSize="11" Foreground="#55CC44"
                                   TextWrapping="Wrap" Margin="0,2,0,12"/>

                        <TextBlock Text="Опис персонажа:" FontSize="12" Foreground="#9CA3AF"/>
                        <TextBlock Text="{Binding Biography}" FontSize="13" TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
