<Application x:Class="OopLab.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgDarkBrush" Color="#14181E"/>
        <SolidColorBrush x:Key="HeaderBgBrush" Color="#1C222B"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="#222933"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#343F4E"/>
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#55CC44"/>
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#38BDF8"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#9CA3AF"/>
    </Application.Resources>
</Application>
